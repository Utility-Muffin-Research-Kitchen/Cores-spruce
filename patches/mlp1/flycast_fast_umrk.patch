# FlyCast Fast UMRK: managed MLP1 source patch for Cores-spruce.
#
# Applies to flyinghead/flycast at 4c293f306bc16a265c2d768af5d0cea138426054,
# the April 2022 core revision pinned for flycast_fast_umrk in
# config/mlp1-core-lock.json. Source-only: no build products, profile data,
# absolute host paths or object-file notices are included.
#
# Replay with:
#   git -C <checkout> clean -ffdx
#   git -C <checkout> apply --ignore-space-change patches/mlp1/flycast_fast_umrk.patch
#
# Runtime identity (P1)
#   core/libretro/libretro.cpp: retro_get_system_info().library_name becomes
#   "FlyCast Fast UMRK", so RetroArch isolates this core's per-core config
#   folder and options from the standalone and current libretro Flycast
#   choices. The option prefix stays "reicast".
#
# Texture-token compatibility (P1)
#   core/libretro/libretro_core_options.h and
#   core/libretro/libretro_core_options_intl.h advertise "1" as the
#   no-upscaling token, labelled "Disabled (1x)", and default to "1".
#   core/libretro/libretro.cpp maps "1", "disabled" and "off" to
#   TextureUpscale = 1, so a live change from 2x back to the no-upscale token
#   cannot leave an upscale active. All 39 localized tables carry the same
#   value list and default, and the v1/v0 option paths are derived from them.
#
# Performance change 1: cached texture anisotropy
#   core/rend/gles/glcache.h tracks GL_TEXTURE_MAX_ANISOTROPY_EXT per texture
#   in the parameter shadow and skips redundant glTexParameterf calls;
#   core/rend/gles/gldraw.cpp routes the anisotropy write through that cache.
#
# Performance change 2: one final texture min-filter assignment
#   core/rend/gles/gldraw.cpp picks the anisotropy-aware minification filter in
#   a single assignment instead of writing a second MIN_FILTER value after the
#   anisotropy call. The final value is unchanged for every tested input
#   combination (tests/flycast_fast_umrk/minfilter_check.cpp).
#
# Performance change 3: lazy common-uniform updates
#   core/rend/gles/gles.h and gles.cpp own a monotonically increasing
#   shader_uniform_serial, advanced once per RenderFrame after PT_ALPHA and the
#   other common ShaderUniforms values are prepared. GetProgram() binds the
#   program and applies the common setter only when the program's stored serial
#   is stale. Compilation marks a program current only when
#   glIsProgram() == GL_TRUE, and teardown advances the serial so programs
#   created afterwards start stale. The RPI4_SET_UNIFORM_ATTRIBUTES_BUG branch
#   keeps its per-use refresh, and the polygon palette, clipping and trilinear
#   writes are untouched.
#
# Build prerequisite 1: MLP1 make lane
#   Makefile adds platform=mlp1 for the old root Makefile lane (FORCE_GLES=1,
#   WITH_DYNAREC=arm64, HAVE_GENERIC_JIT=0, OpenMP off while threaded rendering
#   stays available), gives the lane its own OPTFLAGS branch so the shared -O3
#   cannot override MLP1_OPT, and adds the NOPROF_FILTER exclusion rule the PGO
#   recipe drives.
#
# Build prerequisite 2: GLSM rglGetString return value
#   core/libretro-common/glsm/glsm.c returns glGetString(name), and NULL when
#   neither OpenGL nor OpenGL ES is enabled, instead of falling off the end of
#   a non-void function.
#
# Build prerequisite 3: ARM7 LTO visibility
#   core/hw/arm7/arm7.cpp marks CPUFiq() and CompileCode() used,
#   externally_visible and noinline so the hand-written ARM7 call sites keep
#   their entry points under LTO.
#
# Build prerequisite 4: instrumentation exclusions
#   The NOPROF_FILTER rule above excludes the ARM64 dynarec, the SH4 block
#   cache, fastmem/VMEM, the ARM7 core and libretro/vmem_utils.o: those units
#   call into C/C++ from hand-written assembly with their own register
#   assumptions, so gcov instrumentation stays out of them. No diagnostic
#   counters are compiled in: this patch defines neither
#   FLYCAST_LAZY_UNIFORM_DIAG nor the host-only GLES_UNIFORM_LIGHT seam.
#
# Evidence: tmp/dc-core-bench/lazy-uniform-pgo-20260922 (2026-09-22 experiment).
# Its .gcda counters were produced under a different container source path and
# are not a build input; profiles/mlp1/flycast_fast_umrk documents the frozen
# production dataset instead.
diff --git a/Makefile b/Makefile
index 01d99c304..f4542fc67 100644
--- a/Makefile
+++ b/Makefile
@@ -233,6 +233,43 @@ else ifneq (,$(findstring rpi,$(platform)))
 #########################################
 # (armv7 a7, hard point, neon based) ####
 # NESC, SNESC, C64 mini 
+else ifeq ($(platform), mlp1)
+	EXT ?= so
+	CC_AS    = ${CC_PREFIX}${CC}
+	TARGET := $(TARGET_NAME)_libretro.$(EXT)
+	SHARED += -shared -Wl,--version-script=link.T
+	LDFLAGS +=  -Wl,--no-undefined
+	fpic = -fPIC
+	LIBS += -lrt
+	ARM_FLOAT_ABI_HARD = 0
+	FORCE_GLES = 1
+	SINGLE_PREC_FLAGS = 1
+	CPUFLAGS += -DHOST_CPU=0x20000006 -DTARGET_LINUX_ARMv8 -frename-registers -DNOSSE -D__NEON_OPT
+	MLP1_OPT ?= -O2
+	MLP1_TUNE ?= -mcpu=cortex-a53 -mtune=cortex-a53 -march=armv8-a
+	MLP1_EXTRA_CFLAGS ?=
+	MLP1_EXTRA_CXXFLAGS ?= $(MLP1_EXTRA_CFLAGS)
+	MLP1_EXTRA_LDFLAGS ?=
+	CFLAGS += $(MLP1_OPT) $(MLP1_TUNE) $(CPUFLAGS) $(MLP1_EXTRA_CFLAGS)
+	CXXFLAGS += $(MLP1_OPT) $(MLP1_TUNE) $(CPUFLAGS) $(MLP1_EXTRA_CXXFLAGS)
+	ASFLAGS += $(CFLAGS) -c -frename-registers -fno-strict-aliasing -ftree-vectorize
+	PLATFORM_EXT := unix
+	WITH_DYNAREC=arm64
+	HAVE_GENERIC_JIT = 0
+	HAVE_VULKAN = 0
+	CORE_DEFINES += -DLOW_END
+	# The toolchain sysroot has no libgomp/omp.h, and TexCache.cpp includes it
+	# unconditionally when HAVE_OPENMP is on. The texture-upscale threads it
+	# drives are not used at our fixed native resolution anyway.
+	HAVE_OPENMP = 0
+	# MLP1_TUNE is repeated on the link line on purpose. Under -flto the
+	# compiler recompiles every TU at link time from the link command's
+	# options, not the compile command's; this toolchain's built-in default
+	# is -mcpu=cortex-a55, which then conflicts with the -march=armv8-a
+	# recorded in the LTO sections. Repeating the tune flags keeps the
+	# link-time recompile identical to the compile-time one.
+	LDFLAGS += $(MLP1_TUNE) -static-libgcc -static-libstdc++ $(MLP1_EXTRA_LDFLAGS)
+
 else ifeq ($(platform), classic_armv7_a7)
 	EXT    ?= so
 	TARGET := $(TARGET_NAME)_libretro.$(EXT)
@@ -988,6 +1025,13 @@ ifeq ($(DEBUG),1)
 	OPTFLAGS       := -O0
 	LDFLAGS        += -g
 	CFLAGS         += -g
+else ifeq ($(platform), mlp1)
+	# mlp1 owns its optimisation level through MLP1_OPT. Without this branch
+	# the shared -O3 below is appended after the platform block and silently
+	# overrides it, which would make every ladder rung look like -O3.
+	OPTFLAGS       := $(MLP1_OPT)
+	CORE_DEFINES   += -DNDEBUG
+	LDFLAGS        += -DNDEBUG
 else
 	ifneq (,$(findstring msvc,$(platform)))
 		OPTFLAGS       := -O2
@@ -1191,3 +1235,15 @@ endif
 clean:
 	rm -f $(OBJECTS) $(TARGET)
 
+
+# PGO: the ARM64 dynarec, the SH4 block cache, fastmem/vmem and the ARM7 core
+# call into C++ from hand-written asm with their own register assumptions.
+# gcov instrumentation changes register allocation in those functions and the
+# emulator segfaults on the first fastmem access. Instrument everything else
+# and leave these subsystems alone. NOPROF_FILTER removes the profile flags
+# from these objects entirely, so no missing-profile warning is raised for
+# them; units training never reached elsewhere keep their warnings visible.
+ifneq ($(NOPROF_FILTER),)
+core/rec-ARM64/%.o core/hw/sh4/dyna/%.o core/hw/mem/%.o core/hw/arm7/%.o core/libretro/vmem_utils.o: CFLAGS := $(filter-out $(NOPROF_FILTER),$(CFLAGS))
+core/rec-ARM64/%.o core/hw/sh4/dyna/%.o core/hw/mem/%.o core/hw/arm7/%.o core/libretro/vmem_utils.o: CXXFLAGS := $(filter-out $(NOPROF_FILTER),$(CXXFLAGS))
+endif
diff --git a/core/hw/arm7/arm7.cpp b/core/hw/arm7/arm7.cpp
index 86ba3edc7..c52ade6bd 100644
--- a/core/hw/arm7/arm7.cpp
+++ b/core/hw/arm7/arm7.cpp
@@ -315,6 +315,7 @@ void aicaarm::reset()
 
 extern "C"
 NOINLINE
+__attribute__((used, externally_visible, noinline))
 void CPUFiq()
 {
 	u32 PC = reg[R15_ARM_NEXT].I+4;
@@ -1610,7 +1611,9 @@ void DYNACALL MSR_do(u32 v)
 }
 
 //Compile & run block of code, starting armNextPC
-extern "C" void CompileCode()
+extern "C"
+__attribute__((used, externally_visible, noinline))
+void CompileCode()
 {
 	//Get the code ptr
 	void* rv=EMIT_GET_PTR();
diff --git a/core/libretro-common/glsm/glsm.c b/core/libretro-common/glsm/glsm.c
index 32d599a53..e3f4a95ac 100644
--- a/core/libretro-common/glsm/glsm.c
+++ b/core/libretro-common/glsm/glsm.c
@@ -271,7 +271,9 @@ const GLubyte* rglGetString(GLenum name)
    log_cb(RETRO_LOG_INFO, "glGetString.\n");
 #endif
 #if defined(HAVE_OPENGL) || defined(HAVE_OPENGLES)
-   glGetString(name);
+   return glGetString(name);
+#else
+   return NULL;
 #endif
 }
 
diff --git a/core/libretro/libretro.cpp b/core/libretro/libretro.cpp
index 2efca4b01..619b6aea3 100644
--- a/core/libretro/libretro.cpp
+++ b/core/libretro/libretro.cpp
@@ -854,7 +854,11 @@ static void update_variables(bool first_startup)
 
    if (environ_cb(RETRO_ENVIRONMENT_GET_VARIABLE, &var) && var.value)
    {
-      if (!strcmp("off", var.value))
+      /* "1" is the advertised no-upscaling token for FlyCast Fast UMRK.
+         "disabled" and "off" stay accepted so option files written against
+         other Flycast generations keep meaning "no upscaling" instead of
+         silently leaving a previously selected upscale in place. */
+      if (!strcmp("1", var.value) || !strcmp("disabled", var.value) || !strcmp("off", var.value))
          settings.rend.TextureUpscale = 1;
       else if (!strcmp("2x", var.value))
          settings.rend.TextureUpscale = 2;
@@ -2264,7 +2268,11 @@ const char* retro_get_system_directory(void)
 
 void retro_get_system_info(struct retro_system_info *info)
 {
-   info->library_name = "Flycast";
+   /* FlyCast Fast UMRK is this repository's dedicated MLP1 build of the April
+      2022 Flycast source. The name is deliberately distinct from the other
+      installed Flycast choices so RetroArch keeps its per-core config folder
+      and options separate. */
+   info->library_name = "FlyCast Fast UMRK";
 #ifndef GIT_VERSION
 #define GIT_VERSION ""
 #endif
