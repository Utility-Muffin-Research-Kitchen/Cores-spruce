+	shader->mark_common_uniforms_current();
+#else
+	// Bind before any uniform write: glUniform* targets the active program.
+	// The GL cache suppresses redundant UseProgram calls; callers may bind
+	// again after we return.
+	glcache.UseProgram(shader->program);
+	if (shader->common_uniforms_stale())
