diff --git a/yabause/src/libretro/Makefile b/yabause/src/libretro/Makefile
--- a/yabause/src/libretro/Makefile
+++ b/yabause/src/libretro/Makefile
@@ -107,6 +107,20 @@ else ifeq ($(platform), arm64)
 	USE_AARCH64_DRC = 1
 	DYNAREC_DEVMIYAX = 1
 
+# Miniloong Pocket 1: RK3566 Cortex-A55 with the existing AArch64 GLES 3.0 lane
+else ifeq ($(platform), mlp1_a55_gles3)
+	override platform += unix
+	TARGET := $(TARGET_NAME)_libretro.so
+	fpic := -fPIC
+	SHARED := -shared -Wl,--no-undefined -Wl,--version-script=link.T
+	LDFLAGS += -lpthread
+	ARCH_IS_LINUX = 1
+	HAVE_SSE = 0
+	FORCE_GLES = 1
+	USE_AARCH64_DRC = 1
+	DYNAREC_DEVMIYAX = 1
+	FLAGS += -DAARCH64 -march=armv8-a+crc+fp+simd -mcpu=cortex-a55 -mtune=cortex-a55
+
 # Generic AArch64 Cortex-A53 support with GLES 3.0 like Amlogic G12A or Allwinner H616 
 else ifneq (,$(findstring arm64_cortex_a53_gles3,$(platform)))
 	override platform += unix
